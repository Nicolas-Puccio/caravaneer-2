         "2251":["","Drekar have been defeated!","","¡Los Drekar han sido vencidos!","¡Los Drekar han sido derrotados!","Les Drekar ont été vaincu!","","Os Drekar foram derrotados!","Die Drekar wurden besiegt!","","Drekar a fost învins!","Drekar zostało pokonane!","Drekarlar bozguna uğratıldı!","Drekar is verslagen!","Дрекар был побеждён!","Drekar telah dikalahkan!","","Drekar on tuhottu!","","德瑞卡龍族已經被打敗了！","","Οι Ντρέκαρ νικήθηκαν!","Drekar har blitt beseiret!","","","","","","Tinalo ang mga Drekar!","","","I Drekar sono stati sconfitti!","","A drekar törzs megsemmisült.","","","","","","","","","","Els Drekar han estat vençuts!","","Drekaři byli poraženi!"],
