         "2240":["","100 or nothing.","","100 o no hay trato.","","100 ou rien.","","100 ou nada.","100 oder nichts.","","100 sau nimic.","100 albo nic.","","100 of niets.","100 или ничего.","100 atau lupakan saja.","","","","十萬，否則就拉倒。","","","100 eller glem det.","","","","","","","","","100 o niente.","","","","","","","","","","","","O 100 o res.","","100 nebo nic."],
         "2241":["","I\'m not bargaining with you. I just don\'t have more.","","Vamos. No te toreo. No tengo ná más q\'eso.","Vamos. No te miento. No tengo nada más que eso.","Je ne vais pas négocier avec vous. Je n\'ai tout simplement pas plus.","","Não estou barganhando com tu.Eu só não tenho mais.","Ich handele nicht mit dir. Ich hab einfach nicht mehr.","","Nu negociez cu tine. Pur și simplu n-am mai mult.","Nie targuję się z tobą. Po prostu nie mam więcej.","","Ik onderhandel niet met je. Ik heb gewoon niet meer.","Я не торгуюсь с тобой. У меня просто больше ничего нет.","Saya bukan nak tawar-menawar dengan kau. Ini saja yang saya ada.","","","","我不是跟你套價還價，我真的只有這麼多。","","","Jeg prøver ikke å forhandle, jeg har ikke mer.","","","","","","","","","Non sto contrattando con te. Semplicemente non ne possiedo di più.","","","","","","","","","","","","No t\'astic vacil·lant... No tinc re més q\'això.","","Já s tebou nevyjednávám. Prostě toho víc nemám."],
         "2242":["","It\'s your problem, old man. [leave]","","Ese es tu problema, no el mío, viejo. [marcharse]","","C\'est votre problème, vieux homme. [quitter]","","É um problema teu, velho. [sair]","Das ist dein Problem, alter Mann. [gehen]","","Asta-i problema ta, moşule. [pleacă]","To twój problem, staruszku. [odejdź]","","Dat is jouw probleem, ouwe. [vertrekken]","Это твоя проблема, старик. [уйти]","Ia masalah kamu, orang tua. [Tinggal]","","","","那是你的問題，老頭。[離開]","","","Det er ditt problem gammer\'n. [forlat]","","","","","","","","","E\' un tuo problema, vecchio. [Vattene]","","","","","","","","","","","","És el teu problema, no el meu.","","To je tvůj problém, staříku. [odejít]"],
         "2243":["","How about that donkey of yours?","","¿Y qué me dices de darme uno de tus burros a cambio?","","Que diriez vous de votre âne ?","","E esse seu burro ai?","Wie wäre es mit deinem Esel?","","Dar măgarul ăla al tău?","A ten twój osioł?","","En die ezel van je?","Что насчёт твоего ослика?","Bagaimana dengan keledai kamu?","","","","拿你的驢子來換如何？","","","Hva med eselet ditt?","","","","","","","","","Che ne dici di quel tuo asino?","","","","","","","","","","","","I què me\'n dius de donar-me un dels teus ases a canvi?","","Co takhle tvého osla?"],
         "2244":["","50K and that donkey of yours.","","50 mil y uno de tus burros.","","50 milles et votre âne.","","50K e esse seu burro.","50 tausend und dein Esel.","","50 de mii și măgarul ăla al tău.","50k i ten twój osioł.","","50k en die ezel van je.","50К и этот ослик твой.","50K dan keledai kamu.","","","","五萬再加你的驢子。","","","50K og eselet ditt.","","","","","","","","","50.000 e quel tuo asino.","","","","","","","","","","","","50 mil i un dels teus ases.","","50 tisíc a toho tvého osla."],
         "2245":["","Then the deal is off. Goodbye. [leave]","","Entonces no hay trato. Adiós. [marcharse]","","Alors l\'accord est terminé. Au revoir. [quitter]","","Então não temos um acordo. Tchau. [sair]","Dann ist das Geschäft geplatzt. Auf Wiedersehen. [gehen]","","Atunci am anulat afacerea. La revedere. [pleacă]","W takim razie wymiana jest anulowana. Żegnaj. [odejdź]","","Dan hebben we geen deal. Vaarwel. [vertrekken]","Тогда сделки не будет. До свидания. [уйти]","Kalau begitu urusan dibatalkan. Selamat tinggal. [Tinggal]","","","","那就沒得商量。再見。[離開]","","","Da blir det ingen avtale. Farvel. [forlat]","","","","","","","","","Allora l\'affare è concluso. Arrivederci. [Vattene]","","","","","","","","","","","","Llavors no hi ha tracte. Adéu. [marxar]","","Pak dohoda padá. Sbohem. [odejít]"],
